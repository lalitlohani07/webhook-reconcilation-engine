# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webhook_engine
DB_USERNAME=webhook_user
DB_PASSWORD=webhook_pass
DB_POOL_SIZE=10

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server
SERVER_PORT=8080

# Security (Initial Admin Bootstrap)
APP_SECURITY_BOOTSTRAP_USERNAME=admin
APP_SECURITY_BOOTSTRAP_PASSWORD=your_secure_admin_password_here

# Redis Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_STRATEGY=source
RATE_LIMIT_FAIL_CLOSED=true
